# ── Trading mode ──────────────────────────────────────────────────────────────
# demo   → uses generated data, no exchange connection, no money
# paper  → real exchange data, simulated order execution, no money
# live   → real exchange data, real orders, REAL MONEY
TRADING_MODE=demo

# ── Asset & timeframe ─────────────────────────────────────────────────────────
DEFAULT_ASSET=ETH/USDT
DEFAULT_TIMEFRAME=1h

# ── Exchange (required for paper and live modes) ──────────────────────────────
# Supported: binance, coinbase, kraken, bybit, okx, kucoin (any ccxt exchange)
EXCHANGE=binance

# Leave blank for read-only data access (no order placement)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Set to "true" to use the exchange's sandbox/testnet environment
EXCHANGE_SANDBOX=false

# Starting equity for paper trading (USD)
INITIAL_EQUITY=10000

# ── Telegram alerts (optional) ────────────────────────────────────────────────
# Get a bot token from @BotFather and a chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── OpenAI LLM validation (optional) ─────────────────────────────────────────
# If set, enables optional GPT-based signal confirmation layer
OPENAI_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Risk overrides (optional — leave blank to use engine defaults) ─────────────
# RISK_PER_TRADE_PCT=0.01       # 1% of equity per trade
# MAX_CONCURRENT_TRADES=5
# CONFLUENCE_THRESHOLD=75.0
